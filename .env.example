# Neuron environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Product URL
# Local: http://localhost:3000
# Production: https://app.tryneuron.net
# Set this to the URL of the environment being run; do not use a preview URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/neuron
# DIRECT_URL=postgresql://user:password@host:5432/neuron

# Clerk authentication / Google Sign-In (openid, email, profile only)
# Google social authentication is configured in Clerk, not with Gmail credentials below.
# Copy Clerk's Authorized Redirect URI into that Google Cloud OAuth client.
# Current production Clerk redirect: https://clerk.app.tryneuron.net/v1/oauth_callback
# Development Clerk instances use Clerk's shared Google OAuth credentials by default.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
GOOGLE_OAUTH_DEBUG_SAFE=false
# Internal testing only. Keep false in public production to show Gmail and Teams as Upcoming.
ENABLE_UPCOMING_INTEGRATION_TESTING=false

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key

# Pinecone vector database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index_name

# Slack integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must exactly match a redirect URL configured in the Slack app dashboard.
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback
# Optional. Leave blank for Slack's normal workspace chooser.
# If the app is not publicly distributed, Slack only allows authorization in the app's original workspace.
SLACK_ALLOWED_TEAM_ID=
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token
SLACK_USER_SYNC_MAX_CONVERSATIONS=50
SLACK_USER_SYNC_MAX_MESSAGES_PER_CONVERSATION=100
SLACK_USER_SYNC_LOOKBACK_DAYS=14

# Notion OAuth integration
NOTION_CLIENT_ID=your_notion_oauth_client_id
NOTION_CLIENT_SECRET=your_notion_oauth_client_secret
# Must exactly match a redirect URI configured for the same Notion OAuth app.
NOTION_REDIRECT_URI=http://localhost:3000/api/integrations/notion/callback
# Production: NOTION_REDIRECT_URI=https://app.tryneuron.net/api/integrations/notion/callback

# Gmail Integration (prefer a separate Google OAuth client from Clerk authentication)
# Use these when Gmail has its own OAuth client. Add gmail.readonly under Google Auth Platform → Data Access.
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# Backward-compatible fallback when the same OAuth client is intentionally shared:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI:
# Local: http://localhost:3000/api/integrations/gmail/callback
# Production: https://app.tryneuron.net/api/integrations/gmail/callback
# If the same OAuth client is used, it must include both Clerk's Sign-In callback and the Gmail redirect URIs.

# Linear integration (OAuth)
LINEAR_CLIENT_ID=your_linear_oauth_client_id
LINEAR_CLIENT_SECRET=your_linear_oauth_client_secret
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret
# Production OAuth callback: https://app.tryneuron.net/api/integrations/linear/callback
# Production webhook: https://app.tryneuron.net/api/integrations/linear/webhook

# Discord integration (OAuth bot install) — OPTIONAL.
# If these are unset the app still builds and runs; only the Discord
# connect/sync routes report "Discord is not configured".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
# Local: http://localhost:3000/api/integrations/discord/callback
# Production: https://app.tryneuron.net/api/integrations/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/integrations/discord/callback

# Granola integration — no app-level env vars required.
# Each user pastes their own personal API key (grn_...) in the Granola card;
# it is encrypted with ENCRYPTION_KEY and stored per workspace.

# WhatsApp Business Cloud API integration — OPTIONAL.
# Users paste their Meta access token and phone number ID in the WhatsApp card.
# Configure the Meta webhook callback to:
# Local: http://localhost:3000/api/integrations/whatsapp/webhook
# Production: https://app.tryneuron.net/api/integrations/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=generate_a_long_random_string
# Optional but recommended: verifies X-Hub-Signature-256 on webhook POSTs.
WHATSAPP_APP_SECRET=

# Telegram Bot API integration — OPTIONAL.
# The webhook URL must be public HTTPS in production or an HTTPS tunnel locally.
# Missing values do not prevent the app from starting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_USERNAME=neuron_mcp_bot
# Safe operational webhook logs only; never logs message text or raw chat IDs.
TELEGRAM_DEBUG_SAFE=false
# Bounded public t.me channel import. Disabled until explicitly enabled.
TELEGRAM_PUBLIC_IMPORT_ENABLED=false
TELEGRAM_PUBLIC_IMPORT_MAX_POSTS=50
# Advanced Telegram client/MTProto account sync is design-only and disabled publicly.
TELEGRAM_ACCOUNT_SYNC_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_ACCOUNT_SYNC_MAX_DIALOGS=100
TELEGRAM_ACCOUNT_SYNC_MAX_MESSAGES_PER_CHAT=200
TELEGRAM_ACCOUNT_SYNC_LOOKBACK_DAYS=30
TELEGRAM_ACCOUNT_SYNC_MAX_CHATS_PER_RUN=5
TELEGRAM_ACCOUNT_SYNC_MAX_MESSAGES_PER_RUN=1000

# Optional AI refinement for suggested tasks. Explicitly set false for deterministic-only extraction.
TASK_AI_EXTRACTION_ENABLED=true
OPENAI_TASK_EXTRACTION_MODEL=gpt-4o-mini
TASK_EXTRACTION_DEBUG_SAFE=false
TASK_DEFAULT_TIMEZONE=America/Los_Angeles

# Microsoft Teams integration via official Microsoft Graph APIs — OPTIONAL.
# Basic account connection requests: openid, profile, email, offline_access, User.Read.
# Teams sync is requested separately and adds: Team.ReadBasic.All,
# Channel.ReadBasic.All, ChannelMessage.Read.All. Tenant admin consent may be required.
# Local redirect: http://localhost:3000/api/integrations/teams/callback
# Production redirect: https://app.tryneuron.net/api/integrations/teams/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/teams/callback
MICROSOFT_TEAMS_WEBHOOK_CLIENT_STATE=

# Five ELD local-development fallback only. Production customers enter credentials
# in the Five ELD integration screen; Neuron stores them encrypted per workspace.
FIVE_ELD_BASE_URL=https://read.tteld.com
FIVE_ELD_COMPANY_ID=
FIVE_ELD_USDOT=
FIVE_ELD_API_KEY=
FIVE_ELD_PROVIDER_TOKEN=
FIVE_ELD_MAX_PAGES=25
FIVE_ELD_REQUEST_TIMEOUT_MS=15000

# Jira Cloud integration via official Atlassian OAuth 2.0 3LO — OPTIONAL.
# Local redirect: http://localhost:3000/api/integrations/jira/callback
# Production redirect: https://app.tryneuron.net/api/integrations/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Security and scheduled jobs
ENCRYPTION_KEY=64_hex_chars_generate_with_openssl_rand_hex_32
CRON_SECRET=generate_a_long_random_string

# Neuron API / MCP server
NEURON_API_KEY=your_neuron_api_key
NEURON_API_URL=https://app.tryneuron.net
NEURON_WORKSPACE_ID=your_workspace_id

# Optional services
HF_TOKEN=hf_your_huggingface_token
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key
ACTIVITY_TRACKING_STRICT=false

# Public website link enrichment via Firecrawl — OPTIONAL and disabled by default.
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_MAX_LINKS_PER_ITEM=5
FIRECRAWL_MAX_CRAWLS_PER_RUN=25
FIRECRAWL_MAX_CONTENT_CHARS=20000
FIRECRAWL_CACHE_TTL_DAYS=30
FIRECRAWL_REQUEST_TIMEOUT_MS=20000
FIRECRAWL_DEBUG_SAFE=false
